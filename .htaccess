# HandKind Construction — canonical host + URL consolidation
# Requires Apache with mod_rewrite enabled (confirmed live host is Apache).

RewriteEngine On

# 1. Force HTTPS + non-www together, in one hop (avoid a two-redirect chain
#    for http://www.* requests, which would otherwise land here twice: once
#    to fix the scheme, once more to fix the host).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.handkindconstruction\.ca$ [NC]
RewriteRule ^(.*)$ https://handkindconstruction.ca/$1 [L,R=301]

# 2. Collapse /blog/index.html -> /blog/ (avoid duplicate URL for the same page)
RewriteRule ^blog/index\.html$ /blog/ [L,R=301]

# 3. Collapse /index.html -> / site-wide
RewriteRule ^index\.html$ / [L,R=301]
